    email: hemprasad.badagujar@gmail.com
version: 0.3.0
date-released: 2026-09-05
license: CC-BY-NC-SA-4.0
repository-code: "https://github.com/Poshaka-Research-Lab/IndicRecipeNutri-dataset"
keywords:
  - recipe dataset
  - food knowledge graph
  - Indian cuisine
  - nutrition
  - allergens
  - recommender systems
